# Required backend settings
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DB=hrms
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CLIENT_URL=http://localhost:5173

# Cloudinary credentials (Cloudinary Dashboard -> API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# First administrator: created only when the database has no users
ADMIN_NAME=HRMS Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Portfolio demo mode: set true only for a separate demo database.
# Use fictional demo accounts and never connect this database to real employee records.
DEMO_MODE=false
DEMO_ADMIN_NAME=Demo Admin
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=
DEMO_EMPLOYEE_EMAIL=employee@example.com
DEMO_EMPLOYEE_PASSWORD=
