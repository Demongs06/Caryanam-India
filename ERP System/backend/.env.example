# Local backend configuration
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DB=hrms
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CLIENT_URL=http://localhost:5173

# Cloudinary credentials from the Cloudinary dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# First administrator (created only if the employees collection is empty)
ADMIN_NAME=HRMS Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Separate portfolio demo database only; never use for real employee data
DEMO_MODE=false
DEMO_ADMIN_NAME=Demo Admin
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=
DEMO_EMPLOYEE_EMAIL=employee@example.com
DEMO_EMPLOYEE_PASSWORD=
